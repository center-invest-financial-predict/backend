# Copy to .env on homelab and replace every placeholder with a unique value.
HOST_BIND_ADDRESS=192.168.31.206
POSTGRES_DB=financial_predict
POSTGRES_USER=financial_predict
POSTGRES_PASSWORD=replace-with-a-random-password
REDIS_PASSWORD=replace-with-another-random-password
APP_ADMIN_EMAIL=admin@example.local
APP_ADMIN_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
INTEGRATION_API_KEY=replace-with-a-shared-random-key
SEED_COMPANY_CODES=C001,C002,C003
ML_CORE_URL=http://ml-core:8000
ML_CORE_ENABLED=true
FORECAST_SOURCE=auto
ASSISTANT_PROVIDER=ml-core
