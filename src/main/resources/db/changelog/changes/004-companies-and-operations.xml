<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="004-create-companies" author="hackathon">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="companies"/>
            </not>
        </preConditions>
        <createTable tableName="companies">
            <column name="inn" type="VARCHAR(12)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_code" type="VARCHAR(10)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="legal_form" type="VARCHAR(50)"/>
            <column name="industry" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="004-load-companies" author="hackathon">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="companies"/>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM companies</sqlCheck>
        </preConditions>
        <loadData tableName="companies"
                  file="db/data/companies.csv"
                  relativeToChangelogFile="false"
                  separator=","
                  encoding="UTF-8">
            <column name="inn" type="STRING"/>
            <column name="company_code" type="STRING"/>
            <column name="name" type="STRING"/>
            <column name="legal_form" type="STRING"/>
            <column name="industry" type="STRING"/>
        </loadData>
    </changeSet>

    <changeSet id="004-cleanup-unknown-user-inns" author="hackathon">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="user_inns"/>
            <tableExists tableName="companies"/>
        </preConditions>
        <sql>
            DELETE FROM user_inns
            WHERE inn NOT IN (SELECT inn FROM companies)
        </sql>
    </changeSet>

    <changeSet id="004-fk-user-inns-company" author="hackathon">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="user_inns"/>
            <tableExists tableName="companies"/>
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_user_inns_company"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
                baseTableName="user_inns"
                baseColumnNames="inn"
                referencedTableName="companies"
                referencedColumnNames="inn"
                constraintName="fk_user_inns_company"/>
    </changeSet>

    <changeSet id="004-create-operations" author="hackathon">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="operations"/>
            </not>
        </preConditions>
        <createTable tableName="operations">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_inn" type="VARCHAR(12)">
                <constraints nullable="false"
                             foreignKeyName="fk_operations_company"
                             references="companies(inn)"/>
            </column>
            <column name="operation_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="operation_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="NUMERIC(18,2)">
                <constraints nullable="false"/>
            </column>
            <column name="direction" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="counterparty_inn" type="VARCHAR(12)"/>
            <column name="counterparty_name" type="VARCHAR(255)"/>
            <column name="payment_purpose" type="VARCHAR(4000)"/>
            <column name="balance_eod" type="NUMERIC(18,2)"/>
            <column name="source" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="operations"
                             columnNames="company_inn, operation_id"
                             constraintName="uk_operations_company_operation"/>
        <createIndex tableName="operations" indexName="idx_operations_company_date">
            <column name="company_inn"/>
            <column name="operation_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
