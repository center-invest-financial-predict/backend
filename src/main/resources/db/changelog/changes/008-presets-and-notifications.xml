<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="008-forecast-settings-presets" author="hackathon">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="forecast_settings" columnName="presets_json"/>
            </not>
        </preConditions>
        <addColumn tableName="forecast_settings">
            <column name="presets_json" type="TEXT"/>
        </addColumn>
    </changeSet>

    <changeSet id="008-create-notification-reads" author="hackathon">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="notification_reads"/>
            </not>
        </preConditions>
        <createTable tableName="notification_reads">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="company_inn" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="notif_key" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="read_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="notification_reads" columnNames="user_id, company_inn, notif_key"
                             constraintName="uq_notification_reads"/>
        <addForeignKeyConstraint
                baseTableName="notification_reads"
                baseColumnNames="company_inn"
                referencedTableName="companies"
                referencedColumnNames="inn"
                constraintName="fk_notification_reads_company"/>
    </changeSet>
</databaseChangeLog>
