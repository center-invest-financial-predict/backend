<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="003-add-user-fio" author="hackathon">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="users" columnName="last_name"/>
            </not>
        </preConditions>
        <addColumn tableName="users">
            <column name="last_name" type="VARCHAR(100)" defaultValue="-">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(100)" defaultValue="-">
                <constraints nullable="false"/>
            </column>
            <column name="middle_name" type="VARCHAR(100)"/>
        </addColumn>
        <dropDefaultValue tableName="users" columnName="last_name"/>
        <dropDefaultValue tableName="users" columnName="first_name"/>
    </changeSet>

    <changeSet id="003-drop-user-username" author="hackathon">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="users" columnName="username"/>
        </preConditions>
        <dropColumn tableName="users" columnName="username"/>
    </changeSet>

    <changeSet id="003-create-user-inns" author="hackathon">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_inns"/>
            </not>
        </preConditions>
        <createTable tableName="user_inns">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_user_inns_user"
                             references="users(id)"
                             deleteCascade="true"/>
            </column>
            <column name="inn" type="VARCHAR(12)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="user_inns" columnNames="user_id, inn" constraintName="pk_user_inns"/>
    </changeSet>

</databaseChangeLog>
